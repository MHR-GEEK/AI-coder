# HARYX AI Coder - server-side provider configuration
# Add real secrets only in Vercel Project Settings > Environment Variables.
# Never commit a real API key to Git.

AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi_replace_with_your_own_key
AI_MODEL=deepseek-ai/deepseek-v4-flash
AI_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=4096

# Optional provider-specific overrides
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# TOGETHER_API_KEY=

# Local Ollama (development only)
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=llama3.1

# Custom OpenAI-compatible provider
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=replace_with_your_key
# AI_MODEL=your-model-name
