# ==============================================================================
# HARYX AI Coder - Environment Configuration
# ==============================================================================
# Choose your preferred AI provider below.
# For Vercel hosting, Groq and Google Gemini are strongly recommended (both have free tiers).
#
# Supported providers:
#   groq | gemini | openrouter | openai | together | ollama | openai-compatible
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Groq (RECOMMENDED FOR VERCEL - Ultra Fast & Generous Free Tier)
# Get your free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=llama-3.2-11b-vision-preview
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# OPTION 2: Google Gemini (Free Tier Available)
# Get your free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy_your_gemini_key_here
# AI_MODEL=gemini-2.0-flash
# AI_VISION_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# OPTION 3: OpenRouter (Supports Free & Paid Models)
# Get your key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ------------------------------------------------------------------------------
# OPTION 4: OpenAI
# Get your key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your_openai_key_here
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPTION 5: Together AI
# Get your key at: https://api.together.xyz/settings/api-keys
# ------------------------------------------------------------------------------
# AI_PROVIDER=together
# TOGETHER_API_KEY=your_together_key_here
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# AI_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo

# ------------------------------------------------------------------------------
# OPTION 6: Local Ollama (For Local Development Only - Cannot run on Vercel without a tunnel)
# ------------------------------------------------------------------------------
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=llama3.1

# ------------------------------------------------------------------------------
# OPTION 7: Custom OpenAI-Compatible Provider
# ------------------------------------------------------------------------------
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-custom-endpoint.example/v1
# AI_API_KEY=your_key_here
# AI_MODEL=your-model-name
